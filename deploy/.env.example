# IP or DNS name the agents use to reach this VM. It goes into the server
# certificate, so it must match what agents connect to.
XDR_PUBLIC_HOST=192.168.1.10
# Extra names/IPs for the server certificate, comma separated (optional).
XDR_SERVER_NAMES=

XDR_ADMIN_USER=admin
# At least 12 characters. Wrap values containing $ in single quotes, e.g. 'My$ecret-2026',
# or Docker Compose treats $name as a variable.
XDR_ADMIN_PASSWORD=change-me-please

POSTGRES_PASSWORD=change-me-pg
CLICKHOUSE_PASSWORD=change-me-ch

XDR_HTTP_PORT=8080
XDR_EVENT_TTL_DAYS=30

# Agent version this console builds and offers for self-update. Raise it
# and rebuild (docker compose up -d --build) to roll out a new agent.
XDR_VERSION=0.4.0
